#!/usr/bin/env bash
# ==============================================================================
# Configuration for Cloud Spanner Availability & Observability Demo
# ==============================================================================

export PROJECT_ID="my-host-prj-472917"
export PROJECT_NAME="my-host-prj"

# Shared VPC details
export VPC_NETWORK="my-host-prj-shared-vpc"
export VPC_SUBNET="${VPC_SUBNET:-default}"
export VPC_REGION="${VPC_REGION:-us-east4}"

# Spanner Multi-Region Instance Settings
# nam3 spans:
#   - us-east4 (Northern Virginia) - Read-Write (Default Leader)
#   - us-east1 (South Carolina)    - Read-Write (Failover / Alternate Leader)
#   - us-central1 (Iowa)           - Witness / Read-Only
export INSTANCE_ID="${INSTANCE_ID:-spanner-obs-mr}"
export INSTANCE_CONFIG="${INSTANCE_CONFIG:-nam3}"
export INSTANCE_DISPLAY_NAME="Spanner Obs Multi-Region"
export EDITION="${EDITION:-ENTERPRISE_PLUS}"
export PROCESSING_UNITS="${PROCESSING_UNITS:-1000}"

# Spanner Database Settings
export DATABASE_ID="${DATABASE_ID:-finops-obs-db}"
export PRIMARY_LEADER_REGION="us-east4"
export ALTERNATE_LEADER_REGION="us-east1"

# Alerting & Notification Channels (comma-separated emails)
export NOTIFICATION_EMAIL_1="priteshjani@priteshjani.altostrat.com"
export NOTIFICATION_EMAIL_2="priteshjani@google.com"
export NOTIFICATION_EMAILS="${NOTIFICATION_EMAIL_1},${NOTIFICATION_EMAIL_2}"

# Workload Generator Settings
export WORKLOAD_THREADS="${WORKLOAD_THREADS:-4}"
export WORKLOAD_QPS="${WORKLOAD_QPS:-10}"
